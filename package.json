{
  "name": "lodash-challenge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate": "node scripts/generate-challenges.mjs",
    "generate:no-verify": "node scripts/generate-challenges.mjs --no-verify",
    "typecheck:generator": "tsc -p generator/tsconfig.json",
    "test:generator": "node --test \"generator/tests/**/*.test.ts\"",
    "test:app": "node --test \"src/**/*.test.ts\"",
    "test": "pnpm run test:generator && pnpm run test:app"
  },
  "dependencies": {
    "@codesandbox/sandpack-client": "^2.19.8",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.79.0",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
